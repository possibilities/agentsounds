{
  "name": "agentsounds",
  "version": "0.1.0",
  "description": "Procedural UI sounds for the terminal: a library, a CLI, and a TUI over a generate-first sound engine",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentsounds": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "sync": "bun run scripts/sync-upstream.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "0.5.6",
    "node-web-audio-api": "2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
